# /etc/laskah/laskah.env — chmod 600, chown root:root
# 改完执行: sudo systemctl restart laskah

# 只监听本机，公网流量必须经反向代理进来。
HOST=127.0.0.1
PORT=8787

# 数据文件。所在目录必须是 systemd 单元里的 ReadWritePaths。
DATA_FILE=/var/lib/laskah/db.json

# 数据加密主密钥（上游 API Key、访问令牌、网关密钥都用它派生的密钥加密）。
# 设置后主密钥不落盘；留空则自动生成 /var/lib/laskah/db.master.key。
# 生成: openssl rand -base64 48
MASTER_KEY=CHANGE_ME_LONG_RANDOM_STRING

# 管理 API 的 Bearer 令牌，仅脚本调用需要，等价于超级管理员权限。
# 留空则每次启动沿用数据文件里已有的令牌。
# 生成: openssl rand -hex 24
ADMIN_TOKEN=CHANGE_ME_RANDOM_TOKEN

# 超级管理员账号不在这里配置：
# 首次部署完成后浏览器访问 https://your-domain/setup 亲手创建并保存凭据，
# 账户名会加密落盘、口令只存 PBKDF2 散列，服务端不可读出、不可找回。
#
# 仅在无人值守批量部署时才需要下面两项（会跳过 /setup 引导，安全性更低，
# 用完请立即从本文件删除并重启）：
# ADMIN_USER=
# ADMIN_PASSWORD=

# CORS 收紧到自己的域名。
ALLOW_ORIGIN=https://laskah.example.com

# 在反向代理后面必须开，否则登录限速会把所有人算作同一个 IP。
TRUST_PROXY=true

# 负载均衡与故障转移。
STRATEGY=weighted-random
MAX_RETRIES=3
COOLDOWN_MS=30000
FAILURE_THRESHOLD=3

# 后台余额到期扫描周期（毫秒）。真正的查询频率由每个账号的
# “自动查询间隔（分钟）”决定，设为 0 的账号不会被后台查询。
BALANCE_INTERVAL_MS=60000

# 请求路径上等待余额刷新的上限（毫秒）。到点先放行请求，
# 额度查询继续在后台跑完并写回，供下一次请求判定。
# 额度站点普遍很慢（Cloudflare + 查库），这里调大只会让聊天请求变慢，
# 想让余额查得更久应该改账号自己的“超时时间”（1-300 秒，默认 30）。
REQUEST_REFRESH_WAIT_MS=5000

# 不带密钥访问 /v1/models 时是否返回公开模型目录（全部可用账号的模型并集）。
# 默认 true：模型名不是机密，先建密钥才能看列表会拖慢接入；
# 目录只含模型名，owned_by 统一署名 laskah，不泄露上游站点与账号数量。
# 需要严格保密供货范围时设为 false，匿名请求退回空列表且单模型查询一律 404。
PUBLIC_MODELS=true

# 访问上游站点（模型列表、额度查询、聊天转发）使用的 User-Agent。
# 默认已伪装成 Chrome，因为 Go 默认的 Go-http-client 会被 Cloudflare 一类的
# WAF 直接拦成人机验证页。一般不需要改。
# UPSTREAM_USER_AGENT=
